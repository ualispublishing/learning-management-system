# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# environment files and credentials (commit only a value-free example)
.env
.env.*
!.env.example

# Filled production-acceptance manifests reference protected evidence and named
# approvers. Commit only the deliberately pending template.
/deployment/provider-acceptance*.json
!/deployment/provider-acceptance.example.json

# logs can contain URLs, identifiers, or upstream error details
*.log

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local databases and journals (may contain learner data)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Quarantined local asset with unknown provenance; the app uses the documented
# generated-original replacement instead.
/assets/images/math_banner.jpg
