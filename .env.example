# Build-time native application identity. Values are institution-owned and are
# intentionally blank in source control.
LMS_IOS_BUNDLE_IDENTIFIER=
LMS_ANDROID_PACKAGE=
LMS_IOS_BUILD_NUMBER=
LMS_ANDROID_VERSION_CODE=

# Protected production-promotion inputs. The provider manifest must stay out of
# the public app bundle and bind its evidence to the exact source revision.
LMS_PROVIDER_ACCEPTANCE_FILE=
LMS_RELEASE_COMMIT_SHA=

# Development-only native localhost transport override. Production validation
# rejects this when enabled.
LMS_ALLOW_INSECURE_LOCALHOST=0

# Local, loopback-only demo. `npm run web` and `npm run demo:multiuser`
# supply this automatically; do not configure it in a deployed build.
EXPO_PUBLIC_LMS_SHARED_DEMO_URL=
LMS_DEMO_APP_PORT=4178
LMS_DEMO_SERVER_PORT=4180
LMS_DEMO_RESET_KEY=

# Never put tokens, client secrets, passwords, private keys, or credentials in
# EXPO_PUBLIC_* variables; Expo embeds those values in the client bundle.
