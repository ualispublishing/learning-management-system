# Private server configuration. Supply through the operator's secret/config
# system; no values belong in EXPO_PUBLIC_* or a distributed client bundle.
LMS_AUTH_PUBLIC_ORIGIN=
LMS_AUTH_ISSUER=
LMS_AUTH_CLIENT_ID=
LMS_AUTH_CLIENT_SECRET=
LMS_AUTH_DATABASE_PATH=
LMS_AUTH_PORT=4190

# Optional written-assessment gateway. Set all three to enable it; leave all
# unset for auth-only operation. The institution is bound to the database.
# LMS_INSTITUTION_ID=example-school
# LMS_INSTITUTION_NAME=Example School
# LMS_INSTITUTION_TIME_ZONE=America/Toronto
