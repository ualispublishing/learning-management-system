{
  "name": "learning-management-system",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "license": "UNLICENSED",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.1",
    "expo-font": "^57.0.0",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-sharing": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "i18n-js": "^4.5.3",
    "linkify-it": "^5.0.2",
    "markdown-it": "^14.3.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "react-native-worklets-core": "^1.6.3",
    "ts-fsrs": "^5.4.1",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@expo/image-utils": "0.11.5",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/run-shared-demo.mjs",
    "web:standalone": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --max-old-space-size=512 --import tsx --test --test-concurrency=1 --test-timeout=30000 tests/**/*.test.ts",
    "test:coverage": "node --max-old-space-size=512 --experimental-test-coverage --import tsx --test --test-concurrency=1 --test-timeout=30000 tests/**/*.test.ts",
    "test:journeys": "node --import tsx scripts/run-synthetic-journeys.ts",
    "demo:server": "node --import tsx scripts/shared-demo-server.ts",
    "demo:multiuser": "node scripts/run-shared-demo.mjs",
    "demo:reset": "node scripts/reset-shared-demo.mjs",
    "demo:ai:check": "node --import tsx scripts/check-prepared-ai.ts",
    "ai:extract": "node --max-old-space-size=256 --import tsx scripts/extract-ai-source.ts",
    "validate:fixtures": "node --import tsx generate_mocks.ts",
    "validate:security": "node scripts/validate-security.mjs",
    "validate:production-config": "node scripts/validate-production-config.mjs",
    "validate:provider": "node scripts/validate-provider-readiness.mjs",
    "audit:release": "node scripts/audit-production-dependencies.mjs",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "sbom:check": "node scripts/generate-sbom.mjs --check",
    "validate:dependencies": "expo install --check && npm ls --all",
    "build:web": "node scripts/export-web.mjs",
    "verify:web-build": "node scripts/verify-web-build.mjs",
    "check": "npm run brand:check && npm run demo:ai:check && npm run lint && npm run typecheck && npm run validate:fixtures && npm run validate:security && npm run notices:check && npm test && npm run test:journeys",
    "check:server": "npm --prefix server run check",
    "check:release": "npm run check && npm run check:server && npm run validate:dependencies && npm run sbom:check && npm run build:web && npm run verify:web-build",
    "check:production": "npm run validate:production-config && npm run validate:provider && npm run audit:release && npm --prefix server run audit && npm run check:release",
    "brand:sync": "node scripts/sync-branding.mjs",
    "brand:check": "node scripts/sync-branding.mjs --check",
    "prestart": "npm run brand:sync",
    "preweb": "npm run brand:sync",
    "preweb:standalone": "npm run brand:sync",
    "preandroid": "npm run brand:sync",
    "preios": "npm run brand:sync",
    "predemo:multiuser": "npm run brand:sync",
    "prebuild:web": "npm run brand:sync",
    "brand:watch": "npm run brand:sync && node scripts/watch-branding.mjs"
  },
  "private": true,
  "overrides": {
    "decode-uri-component": "0.5.0",
    "linkify-it": "^5.0.2",
    "markdown-it": "^14.3.2",
    "uuid": "^14.0.1"
  }
}
