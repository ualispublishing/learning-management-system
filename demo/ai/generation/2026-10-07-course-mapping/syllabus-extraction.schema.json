{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-grounded syllabus extraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence",
    "warnings"
  ],
  "properties": {
    "courseCode": {
      "type": "string",
      "maxLength": 80
    },
    "courseDuration": {
      "type": "string",
      "maxLength": 300
    },
    "intendedAudience": {
      "type": "string",
      "maxLength": 1000
    },
    "learningObjectives": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "meetingTimes": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "title": {
      "type": "string",
      "maxLength": 300
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "termStart": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "termEnd": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "gradingWeights": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 120
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      }
    },
    "instructorNames": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "schedule": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    },
    "requiredMaterials": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "policies": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "text"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "sourceExcerpt"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "sourceExcerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "sourceLocation": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 600
      }
    }
  }
}
